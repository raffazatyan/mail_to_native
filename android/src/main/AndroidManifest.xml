<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.raffazatyan.mail_to">

  <!--
    Android 11+ package visibility. Merged into the host app's manifest, so
    apps using this plugin do not have to declare anything themselves.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.SENDTO" />
      <data android:scheme="mailto" />
    </intent>
  </queries>

  <application>
    <!--
      Serves the rendered picture to the app the user picks in the chooser.
      The authority is namespaced by the host's applicationId so two apps on
      one device cannot collide.
    -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.mail_to.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/mail_to_file_paths" />
    </provider>
  </application>
</manifest>
